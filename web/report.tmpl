<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>quellog Report</title>
<style>{{.CSS}}</style>
<style>
/* Report mode: show only time filter */
#fileInputSection, #newFileBtn { display: none !important; }
.drop-zone { display: none !important; }
/* Hide dimension filters, keep only time filter */
.filter-bar ql-dropdown { display: none !important; }
.filter-bar .filter-status { display: none !important; }
/* Adjust filter bar layout for report mode */
.filter-bar .filter-bar-content { gap: 0.5rem; }
.filter-bar .filter-apply { margin-left: 0; }

/* Harmonize the Summary tile with the split report: source + size + parse time
   as a one-line eyebrow, three stat cards (size folded into the eyebrow), and
   the date as a centered title above the time-of-day slider. */
#summary .summary-header { justify-content: flex-start; }
#summary .summary-meta {
  display: flex; flex-direction: row; flex-wrap: nowrap; align-items: baseline;
  gap: 0.5rem; white-space: nowrap; max-width: 100%;
  text-align: left; font-size: 0.78rem; color: var(--text-muted, #8a9099);
}
#summary .summary-meta .summary-filename { flex: 0 1 auto; min-width: 3ch; overflow: hidden; text-overflow: ellipsis; }
#summary .summary-meta .summary-parsetime { flex: 0 0 auto; }
#summary .summary-meta .summary-parsetime::before { content: "·"; margin-right: 0.5rem; }
#summary .stat-grid { grid-template-columns: repeat(3, auto) !important; margin-bottom: 0.6rem !important; }
#summary .stat-grid .stat-card:nth-child(2) { display: none; }
#summary .summary-date--title { text-align: center; font-size: 1.3rem; font-weight: 700; margin: 0 0 0.4rem; }
#summary .summary-timeline { margin-top: 0; }
/* Mirror the split strip: full-width track (the 24h day) with a single marker
   row underneath holding the axis ends (00:00/24:00) plus the real data
   start/end times positioned where they fall along the day. */
#summary .summary-timeline-row { display: flex; }
#summary .summary-timeline-track { flex: 1 1 100%; height: 8px; }
#summary .summary-timeline-bound,
#summary .summary-timeline-labels { display: none; }
#summary .summary-tl-marks {
  position: relative; height: 1rem; margin-top: 0.4rem;
  font-size: 0.72rem; color: var(--text-muted, #8a9099); font-variant-numeric: tabular-nums;
}
#summary .summary-tl-mark { position: absolute; white-space: nowrap; transform: translateX(-50%); }
/* Axis ends are lighter than the real data start/end markers. */
#summary .summary-tl-mark.is-start, #summary .summary-tl-mark.is-end { opacity: 0.5; }
#summary .summary-tl-mark.is-start { transform: none; left: 0 !important; }
#summary .summary-tl-mark.is-end { transform: none; left: auto !important; right: 0; }
</style>
</head>
<body>
{{.Body}}
<script>{{.UplotJS}}</script>
<script>
// Report mode: skip WASM initialization
window.REPORT_MODE = true;
window.wasmReady = true;
window.quellogVersion = function() { return '{{.Version}}'; };
window.parseLogFile = function() { console.warn('WASM not available in report mode'); };
</script>
<script>
// Embedded compressed report data (zstd + base64, injected by Go)
const COMPRESSED_DATA = "{{.CompressedData}}";
const ZSTD_DECODER_GZIP_B64 = "{{.FzstdB64}}";

// Load zstd decoder (gzipped and base64-encoded)
async function loadZstdDecoder() {
    try {
        const binaryString = atob(ZSTD_DECODER_GZIP_B64);
        const bytes = new Uint8Array(binaryString.length);
        for (let i = 0; i < binaryString.length; i++) {
            bytes[i] = binaryString.charCodeAt(i);
        }
        const stream = new DecompressionStream('gzip');
        const writer = stream.writable.getWriter();
        writer.write(bytes);
        writer.close();
        const reader = stream.readable.getReader();
        const chunks = [];
        while (true) {
            const { done, value } = await reader.read();
            if (done) break;
            chunks.push(value);
        }
        const totalLength = chunks.reduce((acc, chunk) => acc + chunk.length, 0);
        const result = new Uint8Array(totalLength);
        let offset = 0;
        for (const chunk of chunks) {
            result.set(chunk, offset);
            offset += chunk.length;
        }
        const code = new TextDecoder().decode(result);
        eval(code);
    } catch (err) {
        console.error('Failed to load zstd decoder:', err);
        throw err;
    }
}

// Decompress base64 + zstd data
async function decompressData(base64Data) {
    try {
        await loadZstdDecoder();
        const binaryString = atob(base64Data);
        const bytes = new Uint8Array(binaryString.length);
        for (let i = 0; i < binaryString.length; i++) {
            bytes[i] = binaryString.charCodeAt(i);
        }
        const decompressed = fzstd.decompress(bytes);
        const jsonString = new TextDecoder().decode(decompressed);
        return JSON.parse(jsonString);
    } catch (err) {
        console.error('Failed to decompress data:', err);
        throw err;
    }
}
</script>
<script>{{.AppJS}}</script>
<script>
// Restructure the Summary tile to match the split report's layout: fold the
// size into the parse-time eyebrow, drop the SIZE card, and move the date to a
// centered title above the slider. Pure DOM tweak — app.js is untouched.
function harmonizeSummary() {
    const body = document.querySelector('#summary .summary-body');
    if (!body) return;
    const meta = body.querySelector('.summary-meta');
    const pt = meta && meta.querySelector('.summary-parsetime');
    const szVal = body.querySelector('.stat-grid .stat-card:nth-child(2) .stat-value');
    if (pt && szVal && pt.textContent.indexOf(szVal.textContent) === -1) {
        pt.textContent = szVal.textContent + ' ' + pt.textContent;
    }
    const fn = meta && meta.querySelector('.summary-filename');
    if (fn && !fn.title) fn.title = fn.textContent;
    const date = body.querySelector('.summary-date');
    const timeline = body.querySelector('.summary-timeline');
    if (date && timeline && !date.classList.contains('summary-date--title')) {
        date.classList.add('summary-date--title');
        timeline.parentNode.insertBefore(date, timeline);
    }
    // One marker row under the track: 00:00 / 24:00 axis ends plus the real
    // data start (only if not 00:00) and end times at their positions.
    if (timeline) {
        const seg = timeline.querySelector('.summary-timeline-segment');
        const range = timeline.querySelector('.summary-timeline-range');
        if (seg && range && !timeline.querySelector('.summary-tl-marks')) {
            const left = parseFloat(seg.style.left) || 0;
            const endPct = Math.min(100, left + (parseFloat(seg.style.width) || 0));
            const parts = range.textContent.split('–').map((s) => s.trim());
            const startT = parts[0] || '';
            const endT = parts[1] || startT;
            const marks = document.createElement('div');
            marks.className = 'summary-tl-marks';
            const mk = (txt, pct, cls) => {
                const s = document.createElement('span');
                s.className = 'summary-tl-mark' + (cls ? ' ' + cls : '');
                s.textContent = txt;
                s.style.left = pct + '%';
                marks.appendChild(s);
            };
            const showStart = left > 1.5;
            const showEnd = endPct < 98.5;
            // Drop an axis end when the real start/end sits too close to it, so
            // the labels never overlap (the real time wins).
            if (!(showStart && left < 12)) mk('00:00', 0, 'is-start');
            if (showStart) mk(startT, left);
            if (showEnd) mk(endT, endPct);
            if (!(showEnd && endPct > 88)) mk('24:00', 100, 'is-end');
            timeline.appendChild(marks);
        }
    }
}

// Auto-decompress and render on load
if (COMPRESSED_DATA) {
    console.log('Decompressing embedded report data...');
    decompressData(COMPRESSED_DATA).then(data => {
        console.log('Report data loaded successfully');
        setAnalysisData(data);
        data._parseTimeMs = data.meta.parse_time_ms || 0;
        renderResults(data, data.meta.filename || 'Report', data.meta.filesize || 0, true);
        harmonizeSummary();
    }).catch(err => {
        console.error('Failed to load report:', err);
        alert('Failed to load report data: ' + err.message);
    });
}
</script>
</body>
</html>
