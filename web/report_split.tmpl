<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>quellog Report</title>
<style>{{.CSS}}</style>
<style>
/* Report mode: show only time filter */
#fileInputSection, #newFileBtn { display: none !important; }
.drop-zone { display: none !important; }
.filter-bar ql-dropdown { display: none !important; }
.filter-bar .filter-status { display: none !important; }
.filter-bar .filter-bar-content { gap: 0.5rem; }
.filter-bar .filter-apply { margin-left: 0; }
/* Period navigator (split reports) — a compact heatmap of small squares
   injected into the Summary tile. Square colour intensity encodes the entry
   volume (danger hue when the period had errors); color-mix keeps it correct
   in both light and dark themes. */
/* Split layout: the big date is redundant with the period label, so drop it.
   The source + parse time become a discreet eyebrow (the existing meta line),
   and the period label is the tile heading, above the heatmap. */
#summary .summary-date { display: none; }
#summary .summary-header { justify-content: flex-start; }
#summary .summary-meta {
  display: flex; flex-direction: row; flex-wrap: nowrap; align-items: baseline;
  gap: 0.5rem; white-space: nowrap; max-width: 100%;
  text-align: left; font-size: 0.78rem; color: var(--text-muted, #8a9099);
}
/* Only the source name may be truncated; the size and parse time stay whole. */
#summary .summary-meta .summary-filename { flex: 0 1 auto; min-width: 3ch; overflow: hidden; text-overflow: ellipsis; }
#summary .summary-meta .summary-parsetime { flex: 0 0 auto; }
/* The size is folded into the parse-time text ("9.87 MB parsed in 32ms"), so a
   single dot separates the source from that one phrase. */
#summary .summary-meta .summary-parsetime::before { content: "·"; margin-right: 0.5rem; }
/* The per-period byte size is not tracked, so drop the SIZE stat card and
   collapse the grid to three columns; the full input size goes in the eyebrow. */
#summary .stat-grid { grid-template-columns: repeat(3, auto) !important; }
#summary .stat-grid .stat-card:nth-child(2) { display: none; }
/* The period heatmap doubles as the time axis, so the app.js time-of-day
   slider is redundant — hide it; period bounds go under the heatmap. */
#summary .summary-timeline { display: none; }
.summary-periods { margin: 0.2rem 0; }
.summary-periods-head { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 0.4rem; margin-bottom: 0.5rem; }
.summary-periods-nav { display: flex; align-items: center; gap: 0.4rem; justify-self: center; }
.summary-periods-label { font-size: 1.3rem; font-weight: 700; font-variant-numeric: tabular-nums; }
.summary-periods-btn {
  cursor: pointer; border: 1px solid var(--border, #ddd); background: var(--bg-alt, #f5f6f8);
  color: var(--text, #333); border-radius: 5px; width: 1.25rem; height: 1.25rem;
  font-size: 0.85rem; line-height: 1; display: flex; align-items: center; justify-content: center;
}
.summary-periods-btn:hover:not(:disabled) { border-color: var(--primary, #4a6ea9); color: var(--primary, #4a6ea9); }
.summary-periods-btn:disabled { opacity: 0.3; cursor: default; }
.summary-periods-grid { display: flex; gap: 3px; align-items: stretch; overflow-x: auto; scrollbar-width: thin; }
.summary-periods-bounds {
  display: flex; justify-content: space-between; margin-top: 0.4rem;
  font-size: 0.72rem; color: var(--text-muted, #8a9099); font-variant-numeric: tabular-nums;
}
.ql-seg { flex: 1 1 0; min-width: 6px; height: 10px; background: none; border: 0; padding: 0; cursor: pointer; }
/* Unselected periods are greyscale (intensity = volume); only the selected
   period is in colour (danger hue when it had errors, primary otherwise). */
.ql-seg i {
  display: block; width: 100%; height: 100%; border-radius: 2px;
  outline: 1px solid transparent; outline-offset: -1px;
  background: color-mix(in srgb, var(--text-muted, #8a9099) calc(var(--t, 12) * 1%), transparent);
  transition: background .12s, outline-color .12s;
}
.ql-seg:hover i { outline-color: var(--text-muted, #8a9099); }
/* The selected period stands out by colour alone (no border). */
.ql-seg.active i { background: var(--primary, #4a6ea9); }
.ql-seg.active.has-err i { background: var(--danger, #cc4b4b); }
</style>
</head>
<body>
{{.Body}}
<script>{{.UplotJS}}</script>
<script>
window.REPORT_MODE = true;
window.wasmReady = true;
window.quellogVersion = function() { return '{{.Version}}'; };
window.parseLogFile = function() { console.warn('WASM not available in report mode'); };
</script>
<script>
const ZSTD_DECODER_GZIP_B64 = "{{.FzstdB64}}";

// Embedded per-period report data (each: zstd + base64, injected by Go).
const REPORT_PERIODS = [
{{range .Periods}}  { label: "{{.Label}}", entries: {{.Entries}}, errors: {{.Errors}}, data: "{{.Data}}" },
{{end}}];
const REPORT_TOTAL_SIZE = "{{.TotalSize}}";

let _zstdReady = null;
async function loadZstdDecoder() {
    if (_zstdReady) return _zstdReady;
    _zstdReady = (async () => {
        const binaryString = atob(ZSTD_DECODER_GZIP_B64);
        const bytes = new Uint8Array(binaryString.length);
        for (let i = 0; i < binaryString.length; i++) bytes[i] = binaryString.charCodeAt(i);
        const stream = new DecompressionStream('gzip');
        const writer = stream.writable.getWriter();
        writer.write(bytes); writer.close();
        const reader = stream.readable.getReader();
        const chunks = [];
        while (true) { const { done, value } = await reader.read(); if (done) break; chunks.push(value); }
        const total = chunks.reduce((a, c) => a + c.length, 0);
        const out = new Uint8Array(total);
        let off = 0; for (const c of chunks) { out.set(c, off); off += c.length; }
        eval(new TextDecoder().decode(out));
    })();
    return _zstdReady;
}

async function decompressData(base64Data) {
    await loadZstdDecoder();
    const binaryString = atob(base64Data);
    const bytes = new Uint8Array(binaryString.length);
    for (let i = 0; i < binaryString.length; i++) bytes[i] = binaryString.charCodeAt(i);
    const decompressed = fzstd.decompress(bytes);
    return JSON.parse(new TextDecoder().decode(decompressed));
}
</script>
<script>{{.AppJS}}</script>
<script>
// Period navigator: a compact heatmap embedded in the Summary tile. Each
// square encodes a period's entry volume as colour intensity (danger hue when
// it had errors). renderResults rebuilds the tile on every switch, so the
// navigator is re-injected after each render. Datasets decompress lazily and
// are cached; rendering reuses the report's global entry points (no app.js
// change).
const _periodCache = {};
let _curPeriod = 0;

const _fmtInt = (n) => (n || 0).toLocaleString();
const _maxEntries = REPORT_PERIODS.reduce((m, p) => Math.max(m, p.entries || 0), 1);

async function showPeriod(idx) {
    if (idx < 0 || idx >= REPORT_PERIODS.length) return;
    _curPeriod = idx;
    const p = REPORT_PERIODS[idx];
    let data = _periodCache[idx];
    if (!data) {
        try { data = await decompressData(p.data); _periodCache[idx] = data; }
        catch (err) { console.error('Failed to load period', idx, err); alert('Failed to load period: ' + err.message); return; }
    }
    setAnalysisData(data);
    data._parseTimeMs = (data.meta && data.meta.parse_time_ms) || 0;
    renderResults(data, (data.meta && data.meta.filename) || p.label, (data.meta && data.meta.filesize) || 0, true);
    injectPeriodNav();
    window.scrollTo(0, 0);
}

function injectPeriodNav() {
    const host = document.querySelector('#summary .summary-body');
    if (!host || host.querySelector('.summary-periods')) return;

    // Fold the full input size into the parse-time text so size and chrono are
    // one phrase in one span: "9.87 MB parsed in 32ms".
    const meta = host.querySelector('.summary-meta');
    if (meta && REPORT_TOTAL_SIZE) {
        const pt = meta.querySelector('.summary-parsetime');
        if (pt) pt.textContent = REPORT_TOTAL_SIZE + ' ' + pt.textContent;
    }
    // The source name may be ellipsized; expose the full value on hover.
    const fn = meta && meta.querySelector('.summary-filename');
    if (fn && !fn.title) fn.title = fn.textContent;

    const box = document.createElement('div');
    box.className = 'summary-periods';

    const head = document.createElement('div');
    head.className = 'summary-periods-head';
    const spacer = document.createElement('span'); // balances the centered nav
    const nav = document.createElement('div');
    nav.className = 'summary-periods-nav';
    const prev = document.createElement('button');
    prev.className = 'summary-periods-btn'; prev.textContent = '‹';
    prev.title = 'Previous period'; prev.disabled = _curPeriod === 0;
    prev.onclick = () => showPeriod(_curPeriod - 1);
    const label = document.createElement('span');
    label.className = 'summary-periods-label';
    label.textContent = REPORT_PERIODS[_curPeriod].label;
    const next = document.createElement('button');
    next.className = 'summary-periods-btn'; next.textContent = '›';
    next.title = 'Next period'; next.disabled = _curPeriod === REPORT_PERIODS.length - 1;
    next.onclick = () => showPeriod(_curPeriod + 1);
    nav.append(prev, label, next);
    head.append(spacer, nav);

    const grid = document.createElement('div');
    grid.className = 'summary-periods-grid';
    REPORT_PERIODS.forEach((p, i) => {
        const seg = document.createElement('button');
        seg.className = 'ql-seg' + (p.errors ? ' has-err' : '') + (i === _curPeriod ? ' active' : '');
        seg.title = p.label + ' · ' + _fmtInt(p.entries) + ' entries' +
            (p.errors ? ' · ' + _fmtInt(p.errors) + ' errors' : '');
        const fill = document.createElement('i');
        fill.style.setProperty('--t', 12 + Math.round((p.entries || 0) / _maxEntries * 88));
        seg.appendChild(fill);
        seg.onclick = () => showPeriod(i);
        grid.appendChild(seg);
    });

    // Time bounds under the heatmap (first..last period), so the strip reads
    // as a timeline. Show the time-of-day for intraday splits, the date for
    // daily+ splits.
    const shortBound = (lbl) => { const i = lbl.indexOf(' '); return i > 0 ? lbl.slice(i + 1) : lbl; };
    const bounds = document.createElement('div');
    bounds.className = 'summary-periods-bounds';
    const b0 = document.createElement('span');
    b0.textContent = shortBound(REPORT_PERIODS[0].label);
    const b1 = document.createElement('span');
    b1.textContent = shortBound(REPORT_PERIODS[REPORT_PERIODS.length - 1].label);
    bounds.append(b0, b1);

    box.append(head, grid, bounds);
    // Place the period block below the stat cards (the heatmap+timeline sits
    // where the time-of-day slider used to be).
    const anchor = host.querySelector('.stat-grid') || host.querySelector('.summary-header');
    if (anchor) anchor.after(box);
    else host.insertBefore(box, host.firstChild);
    const active = grid.children[_curPeriod];
    if (active) active.scrollIntoView({ block: 'nearest', inline: 'nearest' });
}

document.addEventListener('keydown', (e) => {
    const t = e.target;
    if (t && (t.tagName === 'INPUT' || t.tagName === 'SELECT' || t.tagName === 'TEXTAREA')) return;
    if (e.key === 'ArrowLeft') { showPeriod(_curPeriod - 1); }
    else if (e.key === 'ArrowRight') { showPeriod(_curPeriod + 1); }
});

document.addEventListener('DOMContentLoaded', () => {
    if (REPORT_PERIODS.length) showPeriod(0);
});
</script>
</body>
</html>
