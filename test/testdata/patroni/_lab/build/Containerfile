ARG PG_VERSION=17
FROM docker.io/library/postgres:${PG_VERSION}
ARG PATRONI_VERSION=4.1.5
ENV TZ=UTC
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-venv python3-dev python3-pip build-essential libpq-dev \
        curl iproute2 iptables vim-tiny netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/patroni-venv \
    && /opt/patroni-venv/bin/pip install --no-cache-dir --upgrade pip setuptools wheel \
    && /opt/patroni-venv/bin/pip install --no-cache-dir "patroni[etcd3]==${PATRONI_VERSION}" "psycopg[binary]" python-json-logger

RUN for b in patroni patronictl patroni_raft_controller patroni_wale_restore; do \
        if [ -f /opt/patroni-venv/bin/$b ]; then ln -s /opt/patroni-venv/bin/$b /usr/local/bin/$b; fi; \
    done

RUN mkdir -p /home/postgres/data /home/postgres/conf /var/log/patroni /var/log/postgresql \
    && chown -R postgres:postgres /home/postgres /var/log/patroni /var/log/postgresql \
    && chmod 700 /home/postgres/data

USER postgres
WORKDIR /home/postgres
ENV PATH="/opt/patroni-venv/bin:${PATH}"
ENTRYPOINT ["/opt/patroni-venv/bin/patroni"]
CMD ["/home/postgres/conf/patroni.yml"]
